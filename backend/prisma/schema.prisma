generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id       Int       @id @default(autoincrement())
  nome     String
  email    String    @unique
  senha    String
  tipo     String    @default("cliente")

  anuncios Anuncio[]
  mensagens Mensagem[]
  curtidas  Curtida[]
}

model Anuncio {
  id           Int      @id @default(autoincrement())
  modelo       String
  ano          String
  km           String
  combustivel  String
  cidade       String
  motor        String?
  cor          String?
  precoAvista  String
  precoAprazo  String?
  parcelas     String?
  imagens      String?
  status       String   @default("pendente")
  dataCriacao  DateTime @default(now())

  usuarioId    Int
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])

  mensagens    Mensagem[]
  curtidas     Curtida[]
}

model Mensagem {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String
  telefone  String?
  texto     String
  dataEnvio DateTime @default(now())

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  anuncioId Int?
  anuncio   Anuncio? @relation(fields: [anuncioId], references: [id])
}

model Curtida {
  id        Int      @id @default(autoincrement())
  data      DateTime @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  anuncioId Int
  anuncio   Anuncio @relation(fields: [anuncioId], references: [id])
}